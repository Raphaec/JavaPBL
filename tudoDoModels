package models;

import java.util.List;
import java.util.ArrayList;

public class Cena {
    private final int id;
    private String titulo;
    private List<Dialogo> dialogos; // Substitui o textoNarrativa
    private List<Escolha> escolhas;

    // Construtor agora recebe apenas id e titulo
    public Cena(int id, String titulo) {
        this.id = id;
        this.titulo = titulo;
        this.dialogos = new ArrayList<>();
        this.escolhas = new ArrayList<>();
    }

    public int getId() { return id; }
    public String getTitulo() { return titulo; }

    public List<Dialogo> getDialogos() { return dialogos; }
    public void adicionarDialogo(Dialogo dialogo) { this.dialogos.add(dialogo); }

    public List<Escolha> getEscolhas() { return escolhas; }
    public void adicionarEscolha(Escolha escolha) { this.escolhas.add(escolha); }
}


